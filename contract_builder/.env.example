# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key_here"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.appspot.com"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="your_client_email"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Environment
NODE_ENV="development"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_DEBUG_MODE="false"

# API Configuration
NEXT_PUBLIC_API_URL="https://your-project.vercel.app/api"

# Checkfront API Configuration
# Get these from your Checkfront account: Manage > Setup > API
#
# CHECKFRONT_API_KEY - Your API key (starts with 'cf_' or similar)
# CHECKFRONT_API_SECRET - Your API secret for request signing (required for OAuth/auth methods)
# CHECKFRONT_HOST - Your Checkfront subdomain (e.g., seasaba.checkfront.com)

CHECKFRONT_API_KEY="cf_your_api_key_here"
CHECKFRONT_API_SECRET="your_api_secret_here"
CHECKFRONT_HOST="seasaba.checkfront.com"
