rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for permission checking
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isNotArchived() {
      return getUserData().archived != true;
    }

    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }

    function isManagerOrAbove() {
      return request.auth != null && isNotArchived() &&
             (getUserData().role == 'admin' || getUserData().role == 'hotel-manager');
    }

    function isStaffOrAbove() {
      return request.auth != null && isNotArchived() &&
             (getUserData().role == 'admin' || getUserData().role == 'hotel-manager' || getUserData().role == 'hotel-staff' || getUserData().role == 'employee');
    }

    function isHotelStaff() {
      return request.auth != null && isNotArchived() &&
             (getUserData().role == 'hotel-staff' ||
              getUserData().role == 'hotel-manager');
    }

    function isEmployee() {
      return request.auth != null && isNotArchived() &&
             (getUserData().role == 'employee' ||
              getUserData().role == 'viewer');
    }
    
    function hasPermission(module, requiredLevel) {
      return isAdmin() ? true : (
        request.auth == null || getUserData().archived == true ? false : (
          getUserData().permissions == null ? false : (
            getUserData().permissions[module] == null ? false : (
              // Permission hierarchy: edit > create > view
              getUserData().permissions[module] == 'edit' ? true : (
                getUserData().permissions[module] == 'create' ? (
                  requiredLevel == 'view' || requiredLevel == 'create'
                ) : (
                  getUserData().permissions[module] == 'view' && requiredLevel == 'view'
                )
              )
            )
          )
        )
      );
    }

    function canAccessModule(module) {
      return isAdmin() ? true : (
        request.auth == null || getUserData().archived == true ? false : (
          getUserData().permissions == null ? false : getUserData().permissions[module] != null
        )
      );
    }
    
    function isValidRole(role) {
      return role == 'admin' || role == 'hotel-manager' || role == 'hotel-staff' ||
             role == 'employee' || role == 'viewer';
    }
    
    function isValidPermissionLevel(level) {
      return level == null || level == 'view' || level == 'create' || level == 'edit';
    }
    
    function isValidPermissions(permissions) {
      return (permissions.contracts == null || isValidPermissionLevel(permissions.contracts)) &&
             (permissions.diveLog == null || isValidPermissionLevel(permissions.diveLog)) &&
             (permissions.maintenance == null || isValidPermissionLevel(permissions.maintenance));
    }

    // Check if user has access to a specific hotel
    function hasHotelAccess(hotelId) {
      return getUserData().role == 'admin' ? true : (
        getUserData().hotelId != null && getUserData().hotelId == hotelId
      );
    }

    // Users collection - admins can manage all users, users can read their own and self-register
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if isAdmin();
      // Allow self-registration (user creates their own doc with viewer role) or admin creates
      allow create: if (request.auth != null && request.auth.uid == userId &&
                       request.resource.data.role == 'viewer') ||
                     (isAdmin() &&
                       isValidRole(request.resource.data.role) &&
                       (isValidPermissions(request.resource.data.permissions) || request.resource.data.permissions == null));
      allow update: if isAdmin() &&
                     (isValidRole(request.resource.data.role) || request.resource.data.role == null) &&
                     (isValidPermissions(request.resource.data.permissions) || request.resource.data.permissions == null);
      allow delete: if isAdmin();
    }

    // Hotels collection - combine hotel access with module permissions
    match /hotels/{hotelId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(hotelId) && hasPermission('contracts', 'edit'));
    }

    // Contracts collection - combine hotel access with module permissions
    match /groupContracts/{contractId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow create: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(request.resource.data.hotelId) && hasPermission('contracts', 'create'));
      allow update: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
      allow delete: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
      
      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if isAdmin() 
          || (isStaffOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId) && canAccessModule('contracts'));
        allow write: if isAdmin() 
          || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId) && hasPermission('contracts', 'edit'));
      }
    }

    // Payments collection - combine hotel access with module permissions
    match /payments/{paymentId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) && canAccessModule('contracts'));
      allow create: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(request.resource.data.contractId)).data.hotelId) && hasPermission('contracts', 'create'));
      allow update: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) && hasPermission('contracts', 'edit'));
      allow delete: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) && hasPermission('contracts', 'edit'));
    }

    match /divePackages/{packageId} {
      allow read: if canAccessModule('contracts');
      allow write: if hasPermission('contracts', 'edit');
    }

    // Meal packages - combine hotel access with module permissions
    match /mealPackages/{packageId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Rates - combine hotel access with module permissions
    match /rates/{rateId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Room categories - combine hotel access with module permissions
    match /roomCategories/{categoryId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Room types - combine hotel access with module permissions
    match /roomTypes/{roomTypeId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Seasons - combine hotel access with module permissions
    match /seasons/{seasonId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    match /dives/{diveId} {
      allow read: if canAccessModule('diveLog');
      allow create: if hasPermission('diveLog', 'create');
      allow update, delete: if hasPermission('diveLog', 'edit')
        || (request.auth != null && isNotArchived() && request.auth.uid == resource.data.createdBy);
    }

    match /species/{speciesId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /sites/{siteId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /boats/{boatId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }
    
    match /guides/{guideId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /diveNumber/{diveNumberId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /maintenanceLogs/{logId} {
      allow read: if canAccessModule('maintenance');
      allow create: if hasPermission('maintenance', 'create');
      allow update, delete: if hasPermission('maintenance', 'edit');
    }

    match /assets/{assetId} {
      allow read: if canAccessModule('maintenance');
      allow write: if hasPermission('maintenance', 'edit');
    }

    match /technicians/{techId} {
      allow read: if canAccessModule('maintenance');
      allow write: if hasPermission('maintenance', 'edit');
    }
  }
}