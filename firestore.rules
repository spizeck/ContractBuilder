rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
        && (!("role" in request.resource.data) 
            || request.resource.data.role == resource.data.role)
        || isAdmin();
    }

    // Contracts collection
    match /groupContracts/{contractId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
      
      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if true;
        allow write: if isManagerOrAbove();
      }
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /divePackages/{packageId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /mealPackages/{packageId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /rates/{rateId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /roomCategories/{categoryId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /roomTypes/{roomTypeId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    
    match /dives/{diveId} {
      allow read: if true;
      allow create: if isStaffOrAbove();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isManagerOrAbove();
    }

    match /species/{speciesId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /sites/{siteId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /boats/{boatId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }
    
    match /guides/{guideId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /diveNumber/{diveNumberId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /maintenanceLogs/{logId} {
      allow read, write: if isStaffOrAbove();
    }

    match /assets/{assetId} {
      allow read: if isStaffOrAbove();
      allow write: if isManagerOrAbove();
    }

    match /technicians/{techId} {
      allow read: if isStaffOrAbove();
      allow write: if isManagerOrAbove();
    }

    // MANIFEST SYSTEM COLLECTIONS
    
    // Customers collection
    match /customers/{customerId} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove() && 
                       request.resource.data.bookingReference != '' &&
                       request.resource.data.fullName != '' &&
                       request.resource.data.bookingReference.size() < 50 &&
                       request.resource.data.fullName.size() < 100;
      allow update: if isStaffOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Dive slots collection
    match /diveSlots/{slotId} {
      allow read: if isStaffOrAbove();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Dive assignments collection
    match /diveAssignments/{assignmentId} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isStaffOrAbove();
    }

    // Taxi assignments collection
    match /taxiAssignments/{assignmentId} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isStaffOrAbove();
    }

    // Taxis collection
    match /taxis/{taxiId} {
      allow read: if isStaffOrAbove();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Daily manifests collection
    match /dailyManifests/{manifestId} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Daily taxi lists collection
    match /dailyTaxiLists/{taxiListId} {
      allow read: if isStaffOrAbove();
      allow create: if isStaffOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Crew collection
    match /crew/{crewId} {
      allow read: if isStaffOrAbove();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Import jobs collection
    match /importJobs/{jobId} {
      allow read: if isStaffOrAbove();
      allow create: if isManagerOrAbove();
      allow update: if isManagerOrAbove();
      allow delete: if isManagerOrAbove();
    }

    // Helpers
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManagerOrAbove() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == "admin" || role == "manager";
    }
    
    function isStaffOrAbove() {
    	let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == "admin" || role == "manager" || role == "staff";
    }
  }
}
