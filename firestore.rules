rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for permission checking
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isActiveUser() {
      return request.auth != null && 
             (getUserData().archived == null || getUserData().archived != true);
    }
    
    function isAdmin() {
      return isActiveUser() && getUserData().role == 'admin';
    }

    // Internal employees (you and your staff)
    function isInternalEmployee() {
      return isActiveUser() && 
             (getUserData().role == 'admin' || 
              getUserData().role == 'employee');
    }

    // Hotel portal users
    function isHotelStaff() {
      return isActiveUser() && 
             (getUserData().role == 'hotel-staff' || 
              getUserData().role == 'hotel-manager');
    }

    function isManagerOrAbove() {
      return isActiveUser() &&
             (getUserData().role == 'admin' || 
              getUserData().role == 'hotel-manager');
    }
    
    // Module permission check for internal employees
    function hasPermission(module, requiredLevel) {
      return isInternalEmployee() && (
        isAdmin() || (
          getUserData().permissions != null &&
          getUserData().permissions[module] != null && (
            getUserData().permissions[module] == 'edit' ||
            (getUserData().permissions[module] == 'create' && 
             (requiredLevel == 'view' || requiredLevel == 'create')) ||
            (getUserData().permissions[module] == 'view' && requiredLevel == 'view')
          )
        )
      );
    }
    
    function canAccessModule(module) {
      return isInternalEmployee() && (
        isAdmin() || (
          getUserData().permissions != null && 
          getUserData().permissions[module] != null
        )
      );
    }
    
    function isValidRole(role) {
      return role == 'admin' || 
             role == 'employee' ||
             role == 'hotel-staff' || 
             role == 'hotel-manager' || 
             role == 'viewer';
    }
    
    function isValidPermissionLevel(level) {
      return level == null || level == 'view' || level == 'create' || level == 'edit';
    }
    
    function isValidPermissions(permissions) {
      return permissions == null || (
        (permissions.contracts == null || isValidPermissionLevel(permissions.contracts)) &&
        (permissions.diveLog == null || isValidPermissionLevel(permissions.diveLog)) &&
        (permissions.maintenance == null || isValidPermissionLevel(permissions.maintenance)) &&
        (permissions.operations == null || isValidPermissionLevel(permissions.operations))
      );
    }

    // Check if user has access to a specific hotel
    function hasHotelAccess(hotelId) {
      return isAdmin() || (
        isHotelStaff() && getUserData().hotelId != null && getUserData().hotelId == hotelId
      );
    }

    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if isAdmin() && 
                     isValidRole(request.resource.data.role) &&
                     isValidPermissions(request.resource.data.permissions) &&
                     (request.resource.data.role in ['hotel-staff', 'hotel-manager'] ? 
                       request.resource.data.hotelId != null : true);
      allow update: if isAdmin() && 
                     (isValidRole(request.resource.data.role) || request.resource.data.role == null) &&
                     isValidPermissions(request.resource.data.permissions) &&
                     (resource.data.role in ['hotel-staff', 'hotel-manager'] ? 
                       request.resource.data.hotelId != null : true);
      allow delete: if isAdmin();
    }

    // ========================================
    // CONTRACTS MODULE (Both Internal & Hotel Staff)
    // ========================================
    
    // Hotels collection
    match /hotels/{hotelId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(hotelId));
      
      allow write: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Contracts collection
    match /groupContracts/{contractId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow create: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'create'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(request.resource.data.hotelId));
      
      allow update: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'edit'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(resource.data.hotelId));
        
      allow delete: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'edit'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(resource.data.hotelId));
      
      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if isAdmin() 
          || (isInternalEmployee() && canAccessModule('contracts'))
          || (isHotelStaff() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId));
        
        allow write: if isAdmin() 
          || (isInternalEmployee() && hasPermission('contracts', 'edit'))
          || (getUserData().role == 'hotel-manager' && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId));
      }
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId));
      
      allow create: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'create'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(request.resource.data.contractId)).data.hotelId));
      
      allow update: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'edit'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId));
        
      allow delete: if isAdmin() 
        || (isInternalEmployee() && hasPermission('contracts', 'edit'))
        || (getUserData().role == 'hotel-manager' && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId));
    }

    // Dive packages - visible to anyone with contracts access (internal or hotel)
    match /divePackages/{packageId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || isHotelStaff();
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Meal packages - hotel-specific, visible to hotel staff for their hotel
    match /mealPackages/{packageId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Rates - hotel-specific
    match /rates/{rateId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Room categories - hotel-specific
    match /roomCategories/{categoryId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Room types - hotel-specific
    match /roomTypes/{roomTypeId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // Seasons - hotel-specific
    match /seasons/{seasonId} {
      allow read: if isAdmin() 
        || (isInternalEmployee() && canAccessModule('contracts'))
        || (isHotelStaff() && hasHotelAccess(resource.data.hotelId));
      
      allow write: if isAdmin() || (isInternalEmployee() && hasPermission('contracts', 'edit'));
    }

    // ========================================
    // DIVE LOG MODULE (Internal Employees Only)
    // ========================================
    
    match /dives/{diveId} {
      allow read: if isInternalEmployee() && canAccessModule('diveLog');
      allow create: if isInternalEmployee() && hasPermission('diveLog', 'create');
      allow update: if isInternalEmployee() && 
                       (hasPermission('diveLog', 'edit') || request.auth.uid == resource.data.createdBy);
      allow delete: if isInternalEmployee() && 
                       (hasPermission('diveLog', 'edit') || request.auth.uid == resource.data.createdBy);
    }

    match /species/{speciesId} {
      allow read: if isInternalEmployee() && canAccessModule('diveLog');
      allow write: if isInternalEmployee() && hasPermission('diveLog', 'edit');
    }

    match /sites/{siteId} {
      allow read: if isInternalEmployee() && canAccessModule('diveLog');
      allow write: if isInternalEmployee() && hasPermission('diveLog', 'edit');
    }

    match /guides/{guideId} {
      allow read: if isInternalEmployee() && canAccessModule('diveLog');
      allow write: if isInternalEmployee() && hasPermission('diveLog', 'edit');
    }

    match /diveNumber/{diveNumberId} {
      allow read: if isInternalEmployee() && canAccessModule('diveLog');
      allow write: if isInternalEmployee() && hasPermission('diveLog', 'edit');
    }

    // ========================================
    // MAINTENANCE MODULE (Internal Employees Only)
    // ========================================
    
    match /maintenanceLogs/{logId} {
      allow read: if isInternalEmployee() && canAccessModule('maintenance');
      allow write: if isInternalEmployee() && hasPermission('maintenance', 'create');
    }

    match /assets/{assetId} {
      allow read: if isInternalEmployee() && canAccessModule('maintenance');
      allow write: if isInternalEmployee() && hasPermission('maintenance', 'edit');
    }

    match /technicians/{techId} {
      allow read: if isInternalEmployee() && canAccessModule('maintenance');
      allow write: if isInternalEmployee() && hasPermission('maintenance', 'edit');
    }

    // ========================================
    // OPERATIONS MODULE (Internal Employees Only)
    // ========================================
    
    // Boats - shared between operations and dive log
    match /boats/{boatId} {
      allow read: if isInternalEmployee() && 
                     (canAccessModule('operations') || canAccessModule('diveLog'));
      allow write: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Guests - waiver imports and guest management
    match /guests/{guestId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create') &&
                       request.resource.data.fullName is string &&
                       request.resource.data.fullName.size() > 0 &&
                       request.resource.data.source in ['waiver_import', 'manual', 'checkfront'] &&
                       request.resource.data.duplicateStatus in ['clean', 'potential_duplicate', 'confirmed_unique', 'merged'] &&
                       request.resource.data.dataPriority in ['high', 'medium', 'low'] &&
                       request.resource.data.createdBy == request.auth.uid;
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Import batches - track CSV imports
    match /importBatches/{batchId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isAdmin();
    }

    // Duplicate groups - for duplicate resolution workflow
    match /duplicateGroups/{groupId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Checkfront bookings - synced from API
    match /checkfrontBookings/{bookingId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isAdmin();
    }

    // Manifest runs - daily reconciliation snapshots
    match /manifestRuns/{runId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create') && 
                       request.resource.data.bookingReference != null &&
                       request.resource.data.bookingReference != '' &&
                       request.resource.data.fullName is string;
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Dive assignments collection
    match /diveAssignments/{assignmentId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Taxi assignments collection
    match /taxiAssignments/{assignmentId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Taxis collection
    match /taxis/{taxiId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Daily manifests collection
    match /dailyManifests/{manifestId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Daily taxi lists collection
    match /dailyTaxiLists/{taxiListId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Crew collection
    match /crew/{crewId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }

    // Import jobs collection
    match /importJobs/{jobId} {
      allow read: if isInternalEmployee() && canAccessModule('operations');
      allow create: if isInternalEmployee() && hasPermission('operations', 'create');
      allow update: if isInternalEmployee() && hasPermission('operations', 'edit');
      allow delete: if isInternalEmployee() && hasPermission('operations', 'edit');
    }
  }
}