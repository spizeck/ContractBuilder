rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================
    
    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if user is active (signed in and not archived)
    function isActive() {
      return isSignedIn() && getUserData().archived != true;
    }
    
    // Get current user's data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isActive() && getUserData().role == 'admin';
    }
    
    // Check if user is hotel staff (any hotel role)
    function isHotelStaff() {
      return isActive() && getUserData().role in ['hotel-staff', 'hotel-manager', 'manager'];
    }
    
    // Check if user has specific permission level for a module
    // Admins bypass all permission checks
    // Permission hierarchy: edit (3) > create (2) > view (1)
    function hasPermission(module, level) {
      let user = getUserData();
      
      // Admins have all permissions
      if (user.role == 'admin') {
        return true;
      }
      
      // Check if user has permissions object
      if (!('permissions' in user)) {
        return false;
      }
      
      // Get the permission level for the module
      let userLevel = user.permissions[module];
      
      // Map permission levels to numeric values
      let levelValue = level == 'edit' ? 3 : (level == 'create' ? 2 : (level == 'view' ? 1 : 0));
      let userLevelValue = userLevel == 'edit' ? 3 : (userLevel == 'create' ? 2 : (userLevel == 'view' ? 1 : 0));
      
      // User must have equal or higher permission level
      return userLevelValue >= levelValue;
    }
    
    // ============================================================================
    // USERS COLLECTION
    // ============================================================================
    match /users/{userId} {
      // Users can read their own document or admins can read any
      allow read: if isActive() && (request.auth.uid == userId || isAdmin());
      
      // Only admins can create users
      allow create: if isAdmin();
      
      // Users can update their own name and preferences, admins can update anything
      allow update: if isActive() && (
        (request.auth.uid == userId && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'preferences'])) ||
        isAdmin()
      );
      
      // Never allow delete - use archiving instead
      allow delete: if false;
    }
    
    // ============================================================================
    // DIVE LOG MODULE
    // ============================================================================
    
    // Dives collection
    match /dives/{diveId} {
      allow read: if hasPermission('diveLog', 'view');
      allow create: if hasPermission('diveLog', 'create');
      allow update: if hasPermission('diveLog', 'edit');
      allow delete: if isAdmin() || hasPermission('diveLog', 'edit');
    }
    
    // Reference data - read by anyone with dive log view, write by admin only
    match /boats/{boatId} {
      allow read: if hasPermission('diveLog', 'view');
      allow create, update, delete: if isAdmin();
    }
    
    match /guides/{guideId} {
      allow read: if hasPermission('diveLog', 'view');
      allow create, update, delete: if isAdmin();
    }
    
    match /sites/{siteId} {
      allow read: if hasPermission('diveLog', 'view');
      allow create, update, delete: if isAdmin();
    }
    
    match /species/{speciesId} {
      allow read: if hasPermission('diveLog', 'view');
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================================================
    // MAINTENANCE MODULE
    // ============================================================================
    
    match /assets/{assetId} {
      allow read: if hasPermission('maintenance', 'view');
      allow create: if hasPermission('maintenance', 'create');
      allow update: if hasPermission('maintenance', 'edit');
      allow delete: if isAdmin() || hasPermission('maintenance', 'edit');
    }
    
    match /maintenanceLogs/{logId} {
      allow read: if hasPermission('maintenance', 'view');
      allow create: if hasPermission('maintenance', 'create');
      allow update: if hasPermission('maintenance', 'edit');
      allow delete: if isAdmin() || hasPermission('maintenance', 'edit');
    }
    
    match /technicians/{technicianId} {
      allow read: if hasPermission('maintenance', 'view');
      allow create, update, delete: if isAdmin() || hasPermission('maintenance', 'edit');
    }
    
    // ============================================================================
    // CONTRACTS MODULE
    // ============================================================================
    
    // Hotels - readable by anyone with contracts view
    // Hotel staff can only update their assigned hotel
    match /hotels/{hotelId} {
      allow read: if isActive();
      allow create: if isAdmin();
      allow update: if isAdmin() || 
        (isHotelStaff() && getUserData().hotelId == hotelId);
      allow delete: if isAdmin();
    }
    
    // Contract configuration collections - readable by anyone, writable by admins or contracts:edit
    match /roomCategories/{categoryId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    match /roomTypes/{typeId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    match /seasons/{seasonId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    match /rates/{rateId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    match /divePackages/{packageId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    match /mealPackages/{packageId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    // Group contracts
    match /groupContracts/{contractId} {
      allow read: if hasPermission('contracts', 'view');
      allow create: if hasPermission('contracts', 'create');
      allow update: if hasPermission('contracts', 'edit');
      allow delete: if isAdmin();
      
      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if hasPermission('contracts', 'view');
        allow create: if hasPermission('contracts', 'create');
        allow update: if false; // Notes are immutable
        allow delete: if isAdmin() || hasPermission('contracts', 'edit');
      }
    }
    
    // Payments
    match /payments/{paymentId} {
      allow read: if hasPermission('contracts', 'view');
      allow create: if hasPermission('contracts', 'create');
      allow update: if hasPermission('contracts', 'edit');
      allow delete: if isAdmin() || hasPermission('contracts', 'edit');
    }
    
    // ============================================================================
    // OPERATIONS MODULE
    // ============================================================================
    
    match /customers/{customerId} {
      allow read: if hasPermission('operations', 'view');
      allow create: if hasPermission('operations', 'create');
      allow update: if hasPermission('operations', 'edit');
      allow delete: if isAdmin() || hasPermission('operations', 'edit');
    }
    
    match /dayManifests/{manifestId} {
      allow read: if hasPermission('operations', 'view');
      allow create: if hasPermission('operations', 'create');
      allow update: if hasPermission('operations', 'edit');
      allow delete: if isAdmin() || hasPermission('operations', 'edit');
    }
    
    match /crew/{crewId} {
      allow read: if hasPermission('operations', 'view');
      allow create, update, delete: if isAdmin() || hasPermission('operations', 'edit');
    }
    
    match /taxis/{taxiId} {
      allow read: if hasPermission('operations', 'view');
      allow create, update, delete: if isAdmin() || hasPermission('operations', 'edit');
    }
    
    // ============================================================================
    // DEFAULT DENY
    // ============================================================================
    // Deny access to any collection not explicitly listed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
