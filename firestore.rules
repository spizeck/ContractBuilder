rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Temporarily allow any authenticated user to write
    }

    // Hotels collection - staff can only read/write their assigned hotel, admins can read all
    match /hotels/{hotelId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(hotelId));
    }

    // Contracts collection - staff can only read contracts for their hotel
    match /groupContracts/{contractId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
      
      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if isAdmin() 
          || (isStaffOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId));
        allow write: if isAdmin() 
          || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId));
      }
    }

    // Payments collection - staff can only read payments for their hotel's contracts
    match /payments/{paymentId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId));
    }

    
    match /divePackages/{packageId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    // Meal packages - staff can only read/write for their hotel
    match /mealPackages/{packageId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
    }

    // Rates - staff can only read/write for their hotel
    match /rates/{rateId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
    }

    // Room categories - staff can only read/write for their hotel
    match /roomCategories/{categoryId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
    }

    // Room types - staff can only read/write for their hotel
    match /roomTypes/{roomTypeId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
    }

    // Seasons - staff can only read/write for their hotel
    match /seasons/{seasonId} {
      allow read: if isAdmin() 
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId));
      allow write: if isAdmin() 
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId));
    }

    
    match /dives/{diveId} {
      allow read: if true;
      allow create: if isStaffOrAbove();
      allow update, delete: if request.auth.uid == resource.data.createdBy || isManagerOrAbove();
    }

    match /species/{speciesId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /sites/{siteId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /boats/{boatId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }
    
    match /guides/{guideId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /diveNumber/{diveNumberId} {
      allow read: if true;
      allow write: if isManagerOrAbove();
    }

    match /maintenanceLogs/{logId} {
      allow read, write: if isStaffOrAbove();
    }

    match /assets/{assetId} {
      allow read: if isStaffOrAbove();
      allow write: if isManagerOrAbove();
    }

    match /technicians/{techId} {
      allow read: if isStaffOrAbove();
      allow write: if isManagerOrAbove();
    }

    // Helpers
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManagerOrAbove() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == "admin" || role == "hotel-manager";
    }
    
    function isStaffOrAbove() {
    	let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == "admin" || role == "hotel-manager" || role == "hotel-staff";
    }

    // Check if user has access to a specific hotel
    function hasHotelAccess(hotelId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let userHotelId = userDoc.data.hotelId;
      
      return userDoc.data.role == "admin" ? true : (userHotelId != null && userHotelId == hotelId);
    }
  }
}
