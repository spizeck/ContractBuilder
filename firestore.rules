rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       Helper functions (SAFE)
       ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return signedIn() && exists(userDocPath());
    }

    function getUserData() {
      return get(userDocPath()).data;
    }

    function isNotArchived() {
      return userDocExists() && getUserData().archived != true;
    }

    function isAdmin() {
      return userDocExists() && getUserData().role == 'admin';
    }

    function normalizeLevel(level) {
      return level == 'viewer' ? 'view' : level;
    }

    function isManagerOrAbove() {
      return userDocExists() && isNotArchived() &&
        (getUserData().role == 'admin' ||
         getUserData().role == 'hotel-manager');
    }

    function isStaffOrAbove() {
      return userDocExists() && isNotArchived() &&
        (getUserData().role == 'admin' ||
         getUserData().role == 'hotel-manager' ||
         getUserData().role == 'hotel-staff' ||
         getUserData().role == 'employee');
    }

    // Resolve effective permission for a module: stored value takes precedence,
    // but if null we fall back to the role's default so legacy docs aren't locked out.
    function effectivePermission(module) {
      return (getUserData().permissions != null && getUserData().permissions[module] != null)
        ? normalizeLevel(getUserData().permissions[module])
        : (module == 'diveLog'
            ? ((getUserData().role == 'admin' || getUserData().role == 'hotel-manager' ||
                getUserData().role == 'hotel-staff' || getUserData().role == 'employee') ? 'create' :
               (getUserData().role == 'viewer' ? 'view' : null))
            : (module == 'maintenance'
                ? ((getUserData().role == 'admin' || getUserData().role == 'hotel-manager' ||
                    getUserData().role == 'hotel-staff' || getUserData().role == 'employee') ? 'view' : null)
                : (module == 'contracts'
                    ? ((getUserData().role == 'admin' || getUserData().role == 'hotel-manager') ? 'edit' :
                       (getUserData().role == 'hotel-staff' ? 'view' : null))
                    : (module == 'operations'
                        ? ((getUserData().role == 'admin' || getUserData().role == 'hotel-manager' ||
                            getUserData().role == 'hotel-staff' || getUserData().role == 'employee') ? 'create' : null)
                        : null))));
    }

    function hasPermission(module, requiredLevel) {
      return isAdmin() ? true : (
        !userDocExists() || getUserData().archived == true ? false : (
          effectivePermission(module) == null ? false : (
            // Permission hierarchy: edit > create > view
            effectivePermission(module) == 'edit' ? true : (
              effectivePermission(module) == 'create' ? (
                requiredLevel == 'view' || requiredLevel == 'create'
              ) : (
                effectivePermission(module) == 'view' && requiredLevel == 'view'
              )
            )
          )
        )
      );
    }

    function canAccessModule(module) {
      return isAdmin() ? true : (
        !userDocExists() || getUserData().archived == true ? false : (
          effectivePermission(module) != null
        )
      );
    }

    function isValidRole(role) {
      return role == 'admin' ||
             role == 'hotel-manager' ||
             role == 'hotel-staff' ||
             role == 'employee' ||
             role == 'viewer';
    }

    function isValidPermissionLevel(level) {
      return level == null ||
             level == 'view' ||
             level == 'viewer' ||
             level == 'create' ||
             level == 'edit';
    }

    function isValidPermissions(permissions) {
      return (permissions.contracts == null || isValidPermissionLevel(permissions.contracts)) &&
             (permissions.diveLog == null || isValidPermissionLevel(permissions.diveLog)) &&
             (permissions.maintenance == null || isValidPermissionLevel(permissions.maintenance)) &&
             (permissions.operations == null || isValidPermissionLevel(permissions.operations));
    }

    // Check if user has access to a specific hotel.
    // hotelId == null on the user doc means global access (no hotel restriction).
    function hasHotelAccess(hotelId) {
      return isAdmin() ? true : (
        userDocExists() &&
        (getUserData().hotelId == null || getUserData().hotelId == hotelId)
      );
    }

    /* =========================
       Collections rules
       ========================= */

    // Users collection
    match /users/{userId} {
      // Users can read their own doc; admins can read all user docs
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // List requires read to succeed per doc; admin only
      allow list: if isAdmin();

      // Allow self-registration (user creates their own doc with viewer role) or admin creates
      allow create: if (signedIn() &&
                        request.auth.uid == userId &&
                        request.resource.data.role == 'viewer') ||
                     (isAdmin() &&
                      isValidRole(request.resource.data.role) &&
                      (isValidPermissions(request.resource.data.permissions) ||
                       request.resource.data.permissions == null));

      // Admin can update role/permissions; user can update own doc except role/permissions/archived
      allow update: if (isAdmin() &&
                        (isValidRole(request.resource.data.role) || request.resource.data.role == null) &&
                        (isValidPermissions(request.resource.data.permissions) ||
                         request.resource.data.permissions == null)) ||
                     (signedIn() &&
                      request.auth.uid == userId &&
                      !request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasAny(['role', 'permissions', 'archived']));

      allow delete: if isAdmin();
    }

    // Hotels collection
    match /hotels/{hotelId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(hotelId) && hasPermission('contracts', 'edit'));
    }

    // Contracts collection
    match /groupContracts/{contractId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow create: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(request.resource.data.hotelId) && hasPermission('contracts', 'create'));

      allow update: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));

      allow delete: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));

      // Contract notes subcollection
      match /notes/{noteId} {
        allow read: if isAdmin()
          || (isStaffOrAbove() &&
              hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId) &&
              canAccessModule('contracts'));

        allow write: if isAdmin()
          || (isManagerOrAbove() &&
              hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(contractId)).data.hotelId) &&
              hasPermission('contracts', 'edit'));
      }
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() &&
            hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) &&
            canAccessModule('contracts'));

      allow create: if isAdmin()
        || (isManagerOrAbove() &&
            hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(request.resource.data.contractId)).data.hotelId) &&
            hasPermission('contracts', 'create'));

      allow update: if isAdmin()
        || (isManagerOrAbove() &&
            hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) &&
            hasPermission('contracts', 'edit'));

      allow delete: if isAdmin()
        || (isManagerOrAbove() &&
            hasHotelAccess(get(/databases/$(database)/documents/groupContracts/$(resource.data.contractId)).data.hotelId) &&
            hasPermission('contracts', 'edit'));
    }

    match /divePackages/{packageId} {
      allow read: if canAccessModule('contracts');
      allow write: if hasPermission('contracts', 'edit');
    }

    // Meal packages
    match /mealPackages/{packageId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Rates
    match /rates/{rateId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Room categories
    match /roomCategories/{categoryId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Room types
    match /roomTypes/{roomTypeId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Seasons
    match /seasons/{seasonId} {
      allow read: if isAdmin()
        || (isStaffOrAbove() && hasHotelAccess(resource.data.hotelId) && canAccessModule('contracts'));

      allow write: if isAdmin()
        || (isManagerOrAbove() && hasHotelAccess(resource.data.hotelId) && hasPermission('contracts', 'edit'));
    }

    // Dives
    match /dives/{diveId} {
      allow read: if canAccessModule('diveLog');
      allow create: if hasPermission('diveLog', 'create');
      allow update, delete: if hasPermission('diveLog', 'edit')
        || (signedIn() && isNotArchived() && request.auth.uid == resource.data.createdBy);
    }

    match /species/{speciesId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /sites/{siteId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /boats/{boatId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /guides/{guideId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /diveNumber/{diveNumberId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    match /crew/{crewId} {
      allow read: if canAccessModule('diveLog');
      allow write: if hasPermission('diveLog', 'edit');
    }

    // Maintenance
    match /maintenanceLogs/{logId} {
      allow read: if canAccessModule('maintenance');
      allow create: if hasPermission('maintenance', 'create');
      allow update, delete: if hasPermission('maintenance', 'edit');
    }

    match /assets/{assetId} {
      allow read: if canAccessModule('maintenance');
      allow write: if hasPermission('maintenance', 'edit');
    }

    match /technicians/{techId} {
      allow read: if canAccessModule('maintenance');
      allow write: if hasPermission('maintenance', 'edit');
    }

    /* =========================
       Operations module
       ========================= */

    match /customers/{customerId} {
      allow read: if canAccessModule('operations');
      allow create: if hasPermission('operations', 'create');
      allow update, delete: if hasPermission('operations', 'edit');
    }

    match /dayManifests/{dateId} {
      allow read: if canAccessModule('operations');
      allow create: if hasPermission('operations', 'create');
      allow update, delete: if hasPermission('operations', 'edit');

      match /rows/{rowId} {
        allow read: if canAccessModule('operations');
        allow write: if hasPermission('operations', 'edit');
      }

      match /taxiRuns/{runId} {
        allow read: if canAccessModule('operations');
        allow write: if hasPermission('operations', 'edit');
      }
    }

    match /taxies/{taxiId} {
      allow read: if canAccessModule('operations');
      allow create: if hasPermission('operations', 'create');
      allow update, delete: if hasPermission('operations', 'edit');
    }
  }
}
