rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed contracts - authenticated users can upload/view
    match /signed-contracts/{contractId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Payment receipts - authenticated users can upload/view
    match /payment-receipts/{contractId}/{paymentId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Hotel logos - authenticated users can upload/view
    match /hotels/{hotelId}/logo/{fileName} {
      allow read, write: if request.auth != null;
    }

    // Allow all other authenticated access (fallback for any other files)
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
