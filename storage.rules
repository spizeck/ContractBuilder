rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed contracts - only users with contracts module access
    match /signed-contracts/{contractId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Payment receipts - only users with contracts module access
    match /payment-receipts/{contractId}/{paymentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny all other paths by default (no wildcard rule)
  }
}
