rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed contracts - accessible only to authenticated users
    // Contract-level security is enforced by Firestore rules on contract documents
    match /signed-contracts/{contractId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
