rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read/write their own files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Specific rules for signed contracts
    match /signed-contracts/{contractId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
